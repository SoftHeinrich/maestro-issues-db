  "task_details": {
    "task_details": null,
    "Likert Scale": null,
    "Support Microsoft Azure blob store": {
      "description": "JCloud is a Java library that supports working with different cloud providers, specially compute services and blob stores. One provider is Microsoft Azure. JClouds supports dealing with the blob store of Microsoft Azure. Your task is to explore architectural design decisions related to this functionality.",
      "questions": {
        "question1": {
          "type": "existence",
          "description": "What are the architectural components and connectors in Apache JCloud that supports Microsoft Azure blob store? Briefly name and describe each component, determine their type (physical or logical), determine  how they are connected, and how they achieve the requirements.",
          "design_decision": {
            "existence": true
          }
        },
        "question2": {
          "type": "property",
          "description": "What solutions (e.g., patterns or tactics) are implemented to support quality attributes in Apache JCloud to support Microsoft Azure blob store? Mention the considered quality attributes and describe the solutions applied, and how they achieve the requirements.",
          "design_decision": {
            "property": true
          }
        },
        "question3": {
          "type": "executive",
          "description": "Which tools and technologies are integrated to handle Apache JCloud to support Microsoft Azure blob store? Mention the technologies and tools, their associated components, rationale, and how they achieve the requirements.",
          "design_decision": {
            "executive": true
          }
        }
      }
    },
    "Support of Portability among providers": {
      "description": "JCloud is a Java library that supports working with different cloud providers to store data in the cloud, specially compute services and blob stores. Microsoft Azure blob is One provider from many that are supported. JClouds supports the portability quality attribute, such that developers could change providers without significant changes in their code. Your task is to explore architectural design decisions related to portability.",
      "questions": {
        "question1": {
          "type": "existence",
          "description": "What are the architectural components and connectors in Apache JCloud that supports portability of JCloud for different storage providers including Microsoft Azure blob? Briefly name and describe each component, determine their type (physical or logical), determine  how they are connected, and how they achieve the requirements.",
          "design_decision": {
            "existence": true
          }
        },
        "question2": {
          "type": "property",
          "description": "What solutions (e.g., patterns or tactics) are implemented to support the portability quality attribute in Apache JCloud beyond Microsoft Azure blob store? Mention the considered quality attributes and describe the solutions applied, and how they achieve the requirements.",
          "design_decision": {
            "property": true
          }
        },
        "question3": {
          "type": "executive",
          "description": "Which tools and technologies are integrated to handle Apache JCloud to support portability among different storage providers? Mention the technologies and tools, their associated components, rationale, and how they achieve the requirements.",
          "design_decision": {
            "executive": true
          }
        }
      }
    }
  }
